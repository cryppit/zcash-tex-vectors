   }
  },
  {
   "id": "no-separator",
   "direction": "decode",
   "input": "texs2rt77ggv6q989lr49rkgzmh5slsksa9khdgte",
   "description": "The '1' separator removed.",
   "expect": {
    "valid": false,
    "error": "no-separator"
   }
  },
  {
   "id": "unknown-hrp",
   "direction": "decode",
   "input": "textestnet1s2rt77ggv6q989lr49rkgzmh5slsksa9gjvfrq",
   "description": "A plausible but wrong HRP; only tex, textest and texregtest are TEX.",
   "expect": {
    "valid": false,
    "error": "unknown-hrp"
   }
  },
  {
   "id": "too-long",
   "direction": "decode",
   "input": "tex1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq4jlx23",
   "description": "Over the 90-character limit, which ZIP 320 keeps (ZIP 316 unified addresses drop it).",
   "expect": {
    "valid": false,
    "error": "too-long"
   }
  },
  {
